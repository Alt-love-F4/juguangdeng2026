    "key": "npc.a.name",
    "text": "艾德里安",
    "comment": "A · 短工佣人，出身寒微"
  },
  {
    "key": "npc.a.desc",
    "text": "在王都打短工的年轻人，读过几本禁书。",
    "comment": "A 角色描述"
  },
  {
    "key": "npc.b.name",
    "text": "塞西莉亚",
    "comment": "B · 没落王选者家的小姐"
  },
  {
    "key": "npc.b.desc",
    "text": "家道中落的贵族小姐，不甘于被安排的婚事。",
    "comment": "B 角色描述"
  },
  {
    "key": "npc.c.name",
    "text": "朱利安",
    "comment": "C · 普通王选者家族的少爷"
  },
  {
    "key": "npc.c.desc",
    "text": "出身体面的年轻贵族，一心想娶塞西莉亚。",
    "comment": "C 角色描述"
  },
  {
    "key": "npc.d.name",
    "text": "老伯爵瓦尔蒙",
    "comment": "D · 塞西莉亚的父亲"
  },
  {
    "key": "npc.d.desc",
    "text": "固执的旧贵族，把家族的体面看得比女儿重要。",
    "comment": "D 角色描述"
  },
  {
    "key": "player.name",
    "text": "你",
    "comment": "玩家 · 咖啡馆的旁观者"
  },
  {
    "key": "player.desc",
    "text": "你坐在咖啡馆的角落，看着这一切发生。你可以插手，也可以只是看着。",
    "comment": "玩家描述"
  },
