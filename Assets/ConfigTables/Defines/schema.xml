<?xml version="1.0" encoding="utf-8"?>
<module name="">
  <bean name="TextEntry">
    <var name="key" type="string"/>
    <var name="text" type="string"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbText" value="TextEntry" mode="map" index="key" input="Text.xlsx"/>

  <bean name="RecipeEntry">
    <var name="id" type="string"/>
    <var name="name_key" type="string"/>
    <var name="unlock_rep" type="int"/>
    <var name="price" type="int"/>
    <var name="cup_size" type="string"/>
    <var name="needs_latte_art" type="bool"/>
    <var name="steps" type="string"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbRecipe" value="RecipeEntry" mode="map" index="id" input="Recipe.xlsx"/>

  <bean name="IngredientEntry">
    <var name="id" type="string"/>
    <var name="name_key" type="string"/>
    <var name="max_stock" type="int"/>
    <var name="refill_cost" type="int"/>
    <var name="unlock_rep" type="int"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbIngredient" value="IngredientEntry" mode="map" index="id" input="Ingredient.xlsx"/>

  <bean name="DeviceEntry">
    <var name="id" type="string"/>
    <var name="name_key" type="string"/>
    <var name="base_time" type="float"/>
    <var name="upgraded_time" type="float"/>
    <var name="upgrade_cost" type="int"/>
    <var name="unlock_rep" type="int"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbDevice" value="DeviceEntry" mode="map" index="id" input="Device.xlsx"/>

  <bean name="GameParamEntry">
    <var name="key" type="string"/>
    <var name="value" type="string"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbGameParam" value="GameParamEntry" mode="map" index="key" input="GameParam.xlsx"/>

  <bean name="WorldObjectEntry">
    <var name="id" type="string"/>
    <var name="role" type="string"/>
    <var name="name" type="string"/>
    <var name="item_id" type="string"/>
    <var name="tags" type="string"/>
    <var name="accepts" type="string"/>
    <var name="behavior_id" type="string"/>
    <var name="sprite_path" type="string"/>
    <var name="x" type="float"/>
    <var name="y" type="float"/>
    <var name="height" type="float"/>
    <var name="capacity" type="int"/>
  </bean>
  <table name="TbWorldObject" value="WorldObjectEntry" mode="map" index="id" input="WorldObject.xlsx"/>

  <bean name="RecipeStepEntry">
    <var name="id" type="string"/>
    <var name="recipe_id" type="string"/>
    <var name="sequence" type="int"/>
    <var name="operation" type="string"/>
    <var name="target_id" type="string"/>
    <var name="device_id" type="string"/>
    <var name="amount" type="int"/>
  </bean>
  <table name="TbRecipeStep" value="RecipeStepEntry" mode="map" index="id" input="RecipeStep.xlsx"/>

  <bean name="NpcEntry">
    <var name="id" type="string"/>
    <var name="name" type="string"/>
    <var name="social_id" type="int"/>
    <var name="unlock_rep" type="int"/>
    <var name="sprite_path" type="string"/>
    <var name="dialogue" type="string"/>
  </bean>
  <table name="TbNpc" value="NpcEntry" mode="map" index="id" input="Npc.xlsx"/>
  <bean name="NcsObjectEntry">
    <var name="objId" type="string"/>
    <var name="objType" type="string#set=npc,player,world"/>
    <var name="nameText" type="string#ref=TbText?"/>
    <var name="iconPath" type="string"/>
    <var name="descText" type="string#ref=TbText?"/>
    <var name="tags" type="string"/>
  </bean>
  <table name="TbNcsObject" value="NcsObjectEntry" mode="map" index="objId" input="Object@Narrative.xlsx"/>
  <bean name="NcsBarEntry">
    <var name="barId" type="string"/>
    <var name="ownerId" type="string#ref=TbNcsObject"/>
    <var name="targetId" type="string#ref=TbNcsObject?"/>
    <var name="barType" type="string#set=stat,relation,world"/>
    <var name="min" type="int"/>
    <var name="max" type="int"/>
    <var name="direction" type="string#set=highIsGood,lowIsGood"/>
    <var name="advanceMode" type="string#set=monotonic,event_driven,derived"/>
    <var name="initValue" type="int"/>
    <var name="reverseInitValue" type="int"/>
    <var name="nameText" type="string#ref=TbText?"/>
    <var name="derivedFormula" type="string"/>
    <var name="derivedSources" type="string"/>
    <var name="derivedWeights" type="string"/>
    <var name="autoStep" type="int"/>
  </bean>
  <table name="TbNcsBar" value="NcsBarEntry" mode="list" index="ownerId+barId" input="Bar@Narrative.xlsx"/>
  <bean name="NcsTriggerEntry">
    <var name="triggerId" type="string"/>
    <var name="barKey" type="string"/>
    <var name="threshold" type="int"/>
    <var name="direction" type="string#set=up,down,both"/>
    <var name="crossType" type="string#set=cross,hold"/>
    <var name="onceType" type="string#set=once,repeat"/>
    <var name="reachCount" type="string"/>
    <var name="resetOnExit" type="bool"/>
    <var name="eventId" type="string#ref=TbNcsEvent"/>
    <var name="priority" type="int"/>
    <var name="enabled" type="bool"/>
  </bean>
  <table name="TbNcsTrigger" value="NcsTriggerEntry" mode="map" index="triggerId" input="Trigger@Narrative.xlsx"/>
  <bean name="NcsEventEntry">
    <var name="eventId" type="string"/>
    <var name="eventKind" type="string#set=actor,world"/>
    <var name="presentationClass" type="string"/>
    <var name="presentationKey" type="string"/>
    <var name="presentationLogTag" type="string"/>
    <var name="eventProperty" type="string"/>
    <var name="actorId" type="string#ref=TbNcsObject?"/>
    <var name="targetId" type="string#ref=TbNcsObject?"/>
    <var name="titleText" type="string#ref=TbText?"/>
    <var name="contentKey" type="string"/>
    <var name="setupType" type="string#ref=TbNcsTemplate?"/>
    <var name="setupKey" type="string#ref=TbNcsSetupParams?"/>
    <var name="onceOnly" type="bool"/>
    <var name="logTag" type="string"/>
  </bean>
  <table name="TbNcsEvent" value="NcsEventEntry" mode="map" index="eventId" input="Event@Narrative.xlsx"/>
  <bean name="NcsEventDateEntry">
    <var name="eventId" type="string#ref=TbNcsEvent"/>
    <var name="day" type="int"/>
    <var name="timeSlot" type="string#set=morning,noon,night"/>
    <var name="repeatRule" type="string#set=once,daily,weekly,yearly"/>
    <var name="priority" type="int"/>
  </bean>
  <table name="TbNcsEventDate" value="NcsEventDateEntry" mode="list" input="EventDate@Narrative.xlsx"/>
  <bean name="NcsResultEntry">
    <var name="resultId" type="string"/>
    <var name="eventId" type="string"/>
    <var name="seq" type="int"/>
    <var name="resultType" type="string#set=BAR_ADD,BAR_SET,REL_ADD,SET_FLAG,CLEAR_FLAG,SET_SWITCH,OBJ_STATE,OBJECT_STATE,UNLOCK_EVENT,LOCK_EVENT,ADVANCE_DAY,AWARD_ACH,AWARD_ACHIEVEMENT,PLAY_SETUP,BAR_HINT,SPAWN_NPC,DESPAWN_NPC"/>
    <var name="target" type="string"/>
    <var name="value" type="string"/>
    <var name="note" type="string"/>
  </bean>
  <table name="TbNcsResult" value="NcsResultEntry" mode="map" index="resultId" input="Result@Narrative.xlsx"/>
  <bean name="NcsConditionEntry">
    <var name="conditionId" type="string"/>
    <var name="ownerType" type="string#set=event,choice"/>
    <var name="ownerId" type="string"/>
    <var name="groupIndex" type="int"/>
    <var name="condType" type="string#set=BAR_GTE,BAR_LTE,BAR_BETWEEN,REL_GTE,FLAG_SET,FLAG_CLEAR,SWITCH_ON,EVENT_HAPPENED,EVENT_NOT_HAPPENED,ACTOR_IS,TARGET_IS,LOCATION_EQ,TIMESLOT_EQ,REACH_COUNT_EQ,CHANCE_PCT"/>
    <var name="target" type="string"/>
    <var name="op" type="string"/>
    <var name="value" type="string"/>
    <var name="notFlag" type="bool"/>
  </bean>
  <table name="TbNcsCondition" value="NcsConditionEntry" mode="map" index="conditionId" input="Condition@Narrative.xlsx"/>
  <bean name="NcsTemplateEntry">
    <var name="tplName" type="string"/>
    <var name="descText" type="string"/>
    <var name="interruptType" type="string#set=progressive,playback"/>
    <var name="atomSeq" type="string"/>
    <var name="slotDef" type="string"/>
    <var name="defaultSkip" type="bool"/>
  </bean>
  <table name="TbNcsTemplate" value="NcsTemplateEntry" mode="map" index="tplName" input="Template@Narrative.xlsx"/>
  <bean name="NcsSetupParamsEntry">
    <var name="setupKey" type="string"/>
    <var name="tplName" type="string#ref=TbNcsTemplate"/>
    <var name="slotValues" type="string"/>
    <var name="skipAble" type="bool"/>
    <var name="autoAdvance" type="bool"/>
  </bean>
  <table name="TbNcsSetupParams" value="NcsSetupParamsEntry" mode="map" index="setupKey" input="SetupParams@Narrative.xlsx"/>
  <bean name="NcsChoiceEntry">
    <var name="choiceId" type="string"/>
    <var name="groupKey" type="string"/>
    <var name="textKey" type="string#ref=TbText"/>
    <var name="resultOwnerId" type="string"/>
    <var name="seq" type="int"/>
  </bean>
  <table name="TbNcsChoice" value="NcsChoiceEntry" mode="map" index="choiceId" input="Choice@Narrative.xlsx"/>
</module>
