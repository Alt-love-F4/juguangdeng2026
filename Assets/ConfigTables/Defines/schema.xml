<?xml version="1.0" encoding="utf-8"?>
<module name="">
  <bean name="TextEntry">
    <var name="key" type="string"/>
    <var name="text" type="string"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbText" value="TextEntry" mode="map" index="key" input="Text@Shared/Text.xlsx"/>

  <bean name="RecipeEntry">
    <var name="id" type="string"/>
    <var name="name_key" type="string"/>
    <var name="unlock_rep" type="int"/>
    <var name="price" type="int"/>
    <var name="cup_size" type="string"/>
    <var name="needs_latte_art" type="bool"/>
    <var name="steps" type="string"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbRecipe" value="RecipeEntry" mode="map" index="id" input="Simulation/Recipe.xlsx"/>

  <bean name="IngredientEntry">
    <var name="id" type="string"/>
    <var name="name_key" type="string"/>
    <var name="max_stock" type="int"/>
    <var name="refill_cost" type="int"/>
    <var name="unlock_rep" type="int"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbIngredient" value="IngredientEntry" mode="map" index="id" input="Simulation/Ingredient.xlsx"/>

  <bean name="DeviceEntry">
    <var name="id" type="string"/>
    <var name="name_key" type="string"/>
    <var name="base_time" type="float"/>
    <var name="upgraded_time" type="float"/>
    <var name="upgrade_cost" type="int"/>
    <var name="unlock_rep" type="int"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbDevice" value="DeviceEntry" mode="map" index="id" input="Simulation/Device.xlsx"/>

  <bean name="GameParamEntry">
    <var name="key" type="string"/>
    <var name="value" type="string"/>
    <var name="comment" type="string"/>
  </bean>
  <table name="TbGameParam" value="GameParamEntry" mode="map" index="key" input="Simulation/GameParam.xlsx"/>

  <bean name="WorldObjectEntry">
    <var name="id" type="string"/>
    <var name="role" type="string"/>
    <var name="name" type="string"/>
    <var name="item_id" type="string"/>
    <var name="tags" type="string"/>
    <var name="accepts" type="string"/>
    <var name="behavior_id" type="string"/>
    <var name="sprite_path" type="string"/>
    <var name="x" type="float"/>
    <var name="y" type="float"/>
    <var name="height" type="float"/>
    <var name="capacity" type="int"/>
  </bean>
  <table name="TbWorldObject" value="WorldObjectEntry" mode="map" index="id" input="Simulation/WorldObject.xlsx"/>

  <bean name="RecipeStepEntry">
    <var name="id" type="string"/>
    <var name="recipe_id" type="string"/>
    <var name="sequence" type="int"/>
    <var name="operation" type="string"/>
    <var name="target_id" type="string"/>
    <var name="device_id" type="string"/>
    <var name="amount" type="int"/>
  </bean>
  <table name="TbRecipeStep" value="RecipeStepEntry" mode="map" index="id" input="Simulation/RecipeStep.xlsx"/>

  <bean name="NpcEntry">
    <var name="id" type="string"/>
    <var name="name" type="string"/>
    <var name="social_id" type="int"/>
    <var name="unlock_rep" type="int"/>
    <var name="sprite_path" type="string"/>
    <var name="dialogue" type="string"/>
  </bean>
  <table name="TbNpc" value="NpcEntry" mode="map" index="id" input="Simulation/Npc.xlsx"/>
  <bean name="NcsObjectEntry">
    <var name="objId" type="string"/>
    <var name="objType" type="string#set=npc,player,world"/>
    <var name="nameText" type="string#ref=TbText?"/>
    <var name="iconPath" type="string"/>
    <var name="portraitPath" type="string"/>
    <var name="portraitIndoorPath" type="string"/>
    <var name="avtarPath" type="string"/>
    <var name="descText" type="string#ref=TbText?"/>
    <var name="tags" type="string"/>
  </bean>
  <table name="TbNcsObject" value="NcsObjectEntry" mode="map" index="objId" input="Object@Narrative/Narrative.xlsx"/>
  <bean name="NcsActionEntry">
    <var name="actionKey" type="string"/>
    <var name="type" type="string#set=REPEAT,DAILY,ONCE,TIMED,PROGRESS,FUTURE"/>
    <var name="mustExecute" type="bool"/>
    <var name="nameText" type="string#ref=TbText?"/>
    <var name="descText" type="string#ref=TbText?"/>
    <var name="requirements" type="string"/>
    <var name="resultEvents" type="string"/>
    <var name="durationDays" type="int"/>
    <var name="progressTarget" type="int"/>
    <var name="nextActionKey" type="string"/>
  </bean>
  <table name="TbNcsAction" value="NcsActionEntry" mode="map" index="actionKey" input="Action@Narrative/Narrative.xlsx"/>
  <bean name="NcsMapPositionEntry">
    <var name="positionKey" type="string"/>
    <var name="nameText" type="string#ref=TbText?"/>
    <var name="posX" type="float"/>
    <var name="posY" type="float"/>
    <var name="isImportant" type="bool"/>
    <var name="defaultAction" type="string#ref=TbNcsAction?"/>
    <var name="extendedActions" type="string"/>
    <var name="imgPath" type="string"/>
    <var name="enabled" type="bool"/>
  </bean>
  <table name="TbNcsMapPosition" value="NcsMapPositionEntry" mode="map" index="positionKey" input="MapPosition@Narrative/Narrative.xlsx"/>
  <bean name="NcsBarEntry">
    <var name="barId" type="string"/>
    <var name="ownerId" type="string#ref=TbNcsObject"/>
    <var name="targetId" type="string#ref=TbNcsObject?"/>
    <var name="barType" type="string#set=stat,relation,world"/>
    <var name="min" type="int"/>
    <var name="max" type="int"/>
    <var name="direction" type="string#set=highIsGood,lowIsGood"/>
    <var name="advanceMode" type="string#set=monotonic,event_driven,derived"/>
    <var name="initValue" type="int"/>
    <var name="reverseInitValue" type="int"/>
    <var name="nameText" type="string#ref=TbText?"/>
    <var name="derivedFormula" type="string"/>
    <var name="derivedSources" type="string"/>
    <var name="derivedWeights" type="string"/>
    <var name="autoStep" type="int"/>
  </bean>
  <table name="TbNcsBar" value="NcsBarEntry" mode="list" index="ownerId+barId" input="Bar@Narrative/Narrative.xlsx"/>
  <bean name="NcsTriggerEntry">
    <var name="triggerId" type="string"/>
    <var name="barKey" type="string"/>
    <var name="threshold" type="int"/>
    <var name="direction" type="string#set=up,down,both"/>
    <var name="crossType" type="string#set=cross,hold"/>
    <var name="onceType" type="string#set=once,repeat"/>
    <var name="reachCount" type="string"/>
    <var name="resetOnExit" type="bool"/>
    <var name="eventId" type="string#ref=TbNcsEvent"/>
    <var name="priority" type="int"/>
    <var name="enabled" type="bool"/>
  </bean>
  <table name="TbNcsTrigger" value="NcsTriggerEntry" mode="map" index="triggerId" input="Trigger@Narrative/Narrative.xlsx"/>
  <bean name="NcsEventEntry">
    <var name="eventId" type="string"/>
    <var name="eventKind" type="string#set=actor,world"/>
    <var name="presentationClass" type="string"/>
    <var name="presentationKey" type="string#ref=TbNcsPresentationIndex?"/>
    <var name="presentationLogTag" type="string"/>
    <var name="eventProperty" type="string"/>
    <var name="actorId" type="string#ref=TbNcsObject?"/>
    <var name="targetId" type="string#ref=TbNcsObject?"/>
    <var name="titleText" type="string#ref=TbText?"/>
    <var name="contentKey" type="string"/>
    <var name="setupType" type="string#ref=TbNcsTemplate?"/>
    <var name="setupKey" type="string#ref=TbNcsSetupParams?"/>
    <var name="onceOnly" type="bool"/>
    <var name="logTag" type="string"/>
  </bean>
  <table name="TbNcsEvent" value="NcsEventEntry" mode="map" index="eventId" input="Event@Narrative/Narrative.xlsx"/>

  <bean name="NcsPresentationIndexEntry">
    <var name="presentationKey" type="string"/>
    <var name="presentationClass" type="string#set=Conversation,Reading,Notice,CutScene"/>
    <var name="logTag" type="string"/>
  </bean>
  <table name="TbNcsPresentationIndex" value="NcsPresentationIndexEntry" mode="map" index="presentationKey" input="PresentationIndex@Narrative/Narrative.xlsx"/>

  <bean name="NcsConversationPageEntry">
    <var name="pageId" type="string"/>
    <var name="presentationKey" type="string#ref=TbNcsPresentationIndex"/>
    <var name="seq" type="int"/>
    <var name="pageCondKeys" type="string"/>
    <var name="pageBarConds" type="string"/>
    <var name="optionGroupKey" type="string"/>
    <var name="bgOverride" type="string"/>
    <var name="bgmOverride" type="string"/>
  </bean>
  <table name="TbNcsConversationPage" value="NcsConversationPageEntry" mode="map" index="pageId" input="ConversationPage@Narrative/Narrative.xlsx"/>

  <bean name="NcsConversationLineEntry">
    <var name="lineId" type="string"/>
    <var name="pageId" type="string#ref=TbNcsConversationPage"/>
    <var name="seq" type="int"/>
    <var name="speakerKey" type="string#ref=TbNcsObject?"/>
    <var name="side" type="string#set=left,right"/>
    <var name="textKey" type="string#ref=TbText"/>
    <var name="voiceKey" type="string"/><var name="emote" type="string"/><var name="sfxKey" type="string"/>
    <var name="accentFxKey" type="string"/><var name="accentTargetKey" type="string#ref=TbNcsObject?"/>
  </bean>
  <table name="TbNcsConversationLine" value="NcsConversationLineEntry" mode="list" index="lineId" input="ConversationLine@Narrative/Narrative.xlsx"/>

  <bean name="NcsNoticeEntry">
    <var name="presentationKey" type="string#ref=TbNcsPresentationIndex"/>
    <var name="titleKey" type="string#ref=TbText?"/>
    <var name="timeKey" type="string#ref=TbText?"/><var name="imageKey" type="string"/>
    <var name="textKey" type="string#ref=TbText"/><var name="barConds" type="string"/>
    <var name="noticeBarConds" type="string"/>
  </bean>
  <table name="TbNcsNotice" value="NcsNoticeEntry" mode="map" index="presentationKey" input="Notice@Narrative/Narrative.xlsx"/>

  <bean name="NcsReadingPageEntry">
    <var name="pageId" type="string"/><var name="presentationKey" type="string#ref=TbNcsPresentationIndex"/>
    <var name="seq" type="int"/><var name="titleKey" type="string#ref=TbText?"/>
    <var name="imageKey" type="string"/><var name="pageCondKeys" type="string"/><var name="pageBarConds" type="string"/>
  </bean>
  <table name="TbNcsReadingPage" value="NcsReadingPageEntry" mode="map" index="pageId" input="ReadingPage@Narrative/Narrative.xlsx"/>

  <bean name="NcsReadingLineEntry">
    <var name="lineId" type="string"/><var name="pageId" type="string#ref=TbNcsReadingPage"/>
    <var name="seq" type="int"/><var name="mode" type="string#set=narration,dialogue"/>
    <var name="speakerKey" type="string#ref=TbNcsObject?"/><var name="textKey" type="string#ref=TbText"/><var name="voiceKey" type="string"/>
  </bean>
  <table name="TbNcsReadingLine" value="NcsReadingLineEntry" mode="list" index="lineId" input="ReadingLine@Narrative/Narrative.xlsx"/>
  <bean name="NcsEventDateEntry">
    <var name="eventId" type="string#ref=TbNcsEvent"/>
    <var name="day" type="int"/>
    <var name="timeSlot" type="string#set=morning,noon,night"/>
    <var name="repeatRule" type="string#set=once,daily,weekly,yearly"/>
    <var name="priority" type="int"/>
  </bean>
  <table name="TbNcsEventDate" value="NcsEventDateEntry" mode="list" input="EventDate@Narrative/Narrative.xlsx"/>
  <bean name="NcsResultEntry">
    <var name="resultId" type="string"/>
    <var name="eventId" type="string"/>
    <var name="seq" type="int"/>
    <var name="resultType" type="string#set=BAR_ADD,BAR_SET,REL_ADD,SET_FLAG,CLEAR_FLAG,SET_SWITCH,OBJ_STATE,OBJECT_STATE,UNLOCK_EVENT,LOCK_EVENT,ADVANCE_DAY,AWARD_ACH,AWARD_ACHIEVEMENT,PLAY_SETUP,BAR_HINT,SPAWN_NPC,DESPAWN_NPC"/>
    <var name="target" type="string"/>
    <var name="value" type="string"/>
    <var name="note" type="string"/>
  </bean>
  <table name="TbNcsResult" value="NcsResultEntry" mode="map" index="resultId" input="Result@Narrative/Narrative.xlsx"/>
  <bean name="NcsConditionEntry">
    <var name="conditionId" type="string"/>
    <var name="ownerType" type="string#set=event,choice"/>
    <var name="ownerId" type="string"/>
    <var name="groupIndex" type="int"/>
    <var name="condType" type="string#set=BAR_GTE,BAR_LTE,BAR_BETWEEN,REL_GTE,FLAG_SET,FLAG_CLEAR,SWITCH_ON,EVENT_HAPPENED,EVENT_NOT_HAPPENED,ACTOR_IS,TARGET_IS,LOCATION_EQ,TIMESLOT_EQ,REACH_COUNT_EQ,CHANCE_PCT"/>
    <var name="target" type="string"/>
    <var name="op" type="string"/>
    <var name="value" type="string"/>
    <var name="notFlag" type="bool"/>
  </bean>
  <table name="TbNcsCondition" value="NcsConditionEntry" mode="map" index="conditionId" input="Condition@Narrative/Narrative.xlsx"/>
  <bean name="NcsTemplateEntry">
    <var name="tplName" type="string"/>
    <var name="descText" type="string"/>
    <var name="interruptType" type="string#set=progressive,playback"/>
    <var name="atomSeq" type="string"/>
    <var name="slotDef" type="string"/>
    <var name="defaultSkip" type="bool"/>
  </bean>
  <table name="TbNcsTemplate" value="NcsTemplateEntry" mode="map" index="tplName" input="Template@Narrative/Narrative.xlsx"/>
  <bean name="NcsSetupParamsEntry">
    <var name="setupKey" type="string"/>
    <var name="tplName" type="string#ref=TbNcsTemplate"/>
    <var name="slotValues" type="string"/>
    <var name="skipAble" type="bool"/>
    <var name="autoAdvance" type="bool"/>
  </bean>
  <table name="TbNcsSetupParams" value="NcsSetupParamsEntry" mode="map" index="setupKey" input="SetupParams@Narrative/Narrative.xlsx"/>
  <bean name="NcsChoiceEntry">
    <var name="choiceId" type="string"/>
    <var name="groupKey" type="string"/>
    <var name="textKey" type="string#ref=TbText"/>
    <var name="resultOwnerId" type="string"/>
    <var name="seq" type="int"/>
  </bean>
  <table name="TbNcsChoice" value="NcsChoiceEntry" mode="map" index="choiceId" input="Choice@Narrative/Narrative.xlsx"/>

  <bean name="OpeningPresentationEntry">
    <var name="presentationId" type="string"/>
    <var name="titleKey" type="string#ref=TbText"/>
    <var name="leftNameKey" type="string#ref=TbText"/>
    <var name="rightNameKey" type="string#ref=TbText"/>
    <var name="visualsResource" type="string"/>
  </bean>
  <table name="TbOpeningPresentation" value="OpeningPresentationEntry" mode="map" index="presentationId" input="OpeningPresentation@Narrative/Narrative.xlsx"/>

  <bean name="OpeningLineEntry">
    <var name="lineId" type="string"/>
    <var name="presentationId" type="string#ref=TbOpeningPresentation"/>
    <var name="seq" type="int"/>
    <var name="speaker" type="string#set=narrator,left,right"/>
    <var name="textKey" type="string#ref=TbText"/>
    <var name="gesture" type="string#set=none,nod,shake"/>
    <var name="autoAdvanceSeconds" type="float"/>
  </bean>
  <table name="TbOpeningLine" value="OpeningLineEntry" mode="list" input="OpeningLine@Narrative/Narrative.xlsx"/>
</module>
