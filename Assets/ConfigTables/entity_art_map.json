{
  "name": "freecafe_entity_art_map",
  "description": "把「策划文件」里已生成的多状态素材，按 实体 artId × 状态 映射到 Assets/Art/FreeCafe/Entities/<artId>/<state>.png。状态名必须与运行时枚举一致：制作模式(productionMode=1)下设备状态取自 ProductionPhase（empty/loaded/processing/ready/boiling/warm/room），容器状态取自容量逻辑（empty/coffee/milk/mixed/full），其余为 default。",
  "source_dir": "策划文件",
  "output_dir": "Assets/Art/FreeCafe/Entities",
  "keying": {
    "tolerance": 26,
    "feather": 0.8,
    "pad": 6,
    "min_keep_ratio": 0.04
  },
  "maps": [
