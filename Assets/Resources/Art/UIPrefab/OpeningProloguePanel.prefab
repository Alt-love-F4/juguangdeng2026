  m_Name: 
  m_EditorClassIdentifier: Spotlight.GameFlow.UI::Spotlight.GameFlow.OpeningProloguePanel
  mShowAnimationConfig:
    rid: -2
  mHideAnimationConfig:
    rid: -2
