    7.5 \u79D2\u3001200 ml\uFF0C\u5E76\u4FDD\u6301\u5747\u5300\u3002\n\u505C\u6B62\u6CE8\u6C34\u7ED3\u7B97\u540E\u624D\u5F97\u5230\u7CBE\u7CB9\u5496\u5561\u3002\n\u52A0\u70ED\u666E\u901A\u51B7\u8403\u53EA\u80FD\u5F97\u5230\u9ED1\u5496\u5561\uFF0C\u4E0D\u80FD\u4EE3\u66FF\u7CBE\u7CB9\u3002\n\n\u5012\u5165\u676F\u4E2D\u4EA4\u4ED8\uFF1B\u6309\u6700\u7EC8\u6210\u5206\u4E0E\u542B\u91CF\u8BC4\u4EF7\u3002\n\n<b>\u676F\u578B
