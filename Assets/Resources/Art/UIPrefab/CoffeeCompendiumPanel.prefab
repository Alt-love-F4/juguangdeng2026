    icon: {fileID: 21300000, guid: 8a79ee7c550a49c409e45de6e7aedab2, type: 3}
    tagline: "\u5DF7\u53E3\u6E05\u6668\u7684\u7B2C\u4E00\u676F"
    story: "\u7C97\u7C9D\u3001\u5FAE\u82E6\u3001\u5E72\u8106\u5229\u843D\u3002\u7801\u5934\u5DE5\u4EBA\u4E0E\u62A5\u7AE5\u6700\u5E38\u70B9\u7684\u5C31\u662F\u5B83\u2014\u2014\u4E00\u679A\u94DC\u5E01\uFF0C\u6362\u4E00\u6574\u4E2A\u4E0A\u5348\u7684\u6E05\u9192\u3002"
    steps:
    - "\u5728\u78E8\u8C46\u673A\u4E2D\u7814\u78E8\u5496\u5561\u8C46\uFF0C\u5F97\u5230\u5496\u5561\u7C89\u3002"
    - "\u628A\u5496\u5561\u7C89\u4E0E\u6E05\u6C34\u5012\u8FDB\u540C\u4E00\u4E2A\u5BB9\u5668\uFF0C\u6DF7\u5408\u6210\u51B7\u8403\u3002"
    - "\u653E\u4E0A\u7089\u53F0\u5E76\u70B9\u51FB\u52A0\u70ED\uFF0C\u5230\u6E29\u70ED\u6216\u6CB8\u817E\u5373\u6210\u9ED1\u5496\u5561\u3002"
    - "\u5012\u5165\u5C0F\u676F\uFF0C\u653E\u4E0A\u51FA\u9910\u53E3\u6309\u94C3\u3002"
    tip: "\u52A0\u7CD6\u7B49\u989D\u5916\u539F\u6599\u4F1A\u8BA9\u5B83\u53D8\u6210\u300C\u8FF7\u4E4B\u996E\u54C1\u300D\u3002"
  - productId: cold_brew
    icon: {fileID: 21300000, guid: 7f18bf3c08e52d64ab8b4bfafe11a2b9, type: 3}
    tagline: "\u4E0D\u5FC5\u751F\u706B\u7684\u8010\u5FC3\u4E4B\u4F5C"
    story: "\u5496\u5561\u7C89\u4E0E\u6E05\u6C34\u9759\u9759\u76F8\u4F1A\uFF0C\u4E0D\u7ECF\u7089\u706B\u3002\u53E3\u611F\u5706\u6DA6\uFF0C\u6700\u5408\u590F\u65E5\u5348\u540E\u4E0E\u4E0D\u613F\u4E45\u7B49\u7684\u5BA2\u4EBA\u3002"
    steps:
    - "\u7814\u78E8\u5496\u5561\u8C46\uFF0C\u5F97\u5230\u5496\u5561\u7C89\u3002"
    - "\u628A\u5496\u5561\u7C89\u4E0E\u6E05\u6C34\u5728\u5BB9\u5668\u4E2D\u6DF7\u5408\uFF0C\u5E38\u6E29\u5373\u4E3A\u51B7\u8403\u3002"
    - "\u4E0D\u8981\u52A0\u70ED\uFF0C\u76F4\u63A5\u5012\u5165\u5C0F\u676F\u51FA\u54C1\u3002"
    tip: "\u52A0\u70ED\u540E\u4F1A\u53D8\u6210\u9ED1\u5496\u5561\uFF1B\u51B7\u5374\u4E0B\u6765\u53C8\u4F1A\u56DE\u5230\u51B7\u8403\u3002"
  - productId: milkcoffee
    icon: {fileID: 21300000, guid: b9248e2a4d575f648a53714d903cdaa3, type: 3}
    tagline: "\u9ED1\u5496\u5561\u9047\u4E0A\u4E00\u58F6\u70ED\u725B\u5976"
    story: "\u6BD4\u9ED1\u5496\u5561\u6E29\u67D4\uFF0C\u6BD4\u62FF\u94C1\u6734\u7D20\u3002\u8001\u4E3B\u987E\u4EEC\u8BF4\uFF0C\u8FD9\u662F\u80FD\u559D\u51FA\u5BB6\u91CC\u5473\u9053\u7684\u4E00\u676F\u3002"
    steps:
    - "\u6309\u9ED1\u5496\u5561\u7684\u505A\u6CD5\uFF0C\u51C6\u5907\u597D\u9ED1\u5496\u5561\u3002"
    - "\u628A\u725B\u5976\u52A0\u70ED\u5230\u6E29\u70ED\u4EE5\u4E0A\u3002"
    - "\u5C06\u70ED\u725B\u5976\u4E0E\u9ED1\u5496\u5561\u4E00\u540C\u5012\u5165\u5927\u676F\u3002"
    tip: "\u725B\u5976\u4E00\u5B9A\u8981\u70ED\uFF1B\u8FD9\u676F\u4E0D\u9700\u8981\u62C9\u82B1\u3002"
  - productId: creamcoffee
    icon: {fileID: 21300000, guid: e963214ec48341b46bbc7c7e002e14c1, type: 3}
    tagline: "\u4E00\u6735\u5976\u6CB9\uFF0C\u538B\u4F4F\u82E6\u5473"
    story: "\u5728\u70ED\u9ED1\u5496\u5561\u4E0A\u653E\u4E00\u52FA\u6D53\u5976\u6CB9\uFF0C\u770B\u5B83\u6162\u6162\u5316\u5F00\u3002\u5267\u9662\u6563\u573A\u540E\u7684\u7EC5\u58EB\u4EEC\u504F\u7231\u8FD9\u4E00\u676F\u3002"
    steps:
    - "\u51C6\u5907\u597D\u9ED1\u5496\u5561\uFF0C\u5012\u5165\u5927\u676F\u3002"
    - "\u4ECE\u5976\u6CB9\u7F50\u53D6\u51FA\u5976\u6CB9\u9876\uFF0C\u52A0\u5230\u5496\u5561\u4E0A\u3002"
    tip: "\u4E0D\u8981\u52A0\u725B\u5976\u6216\u62C9\u82B1\uFF0C\u5426\u5219\u5C31\u8BA4\u4E0D\u51FA\u5B83\u4E86\u3002"
  - productId: mocha
    icon: {fileID: 21300000, guid: 699353099008f634bbcab1269bbdcb2f, type: 3}
    tagline: "\u53EF\u53EF\u4E0E\u5496\u5561\u7684\u751C\u871C\u540C\u76DF"
    story: "\u9ED1\u5496\u5561\u91CC\u5316\u5F00\u53EF\u53EF\u7C89\uFF0C\u518D\u76D6\u4E0A\u4E00\u5C42\u5976\u6CB9\u3002\u5B69\u5B50\u4EEC\u773C\u998B\uFF0C\u5927\u4EBA\u4EEC\u4E5F\u820D\u4E0D\u5F97\u8BF4\u4E0D\u3002"
    steps:
    - "\u51C6\u5907\u597D\u9ED1\u5496\u5561\uFF0C\u5012\u5165\u5927\u676F\u3002"
    - "\u52A0\u5165\u53EF\u53EF\u7C89\u3002"
    - "\u653E\u4E0A\u5976\u6CB9\u9876\uFF0C\u5373\u53EF\u51FA\u54C1\u3002"
    tip: "\u6469\u5361\u4E0D\u9700\u8981\u725B\u5976\u2014\u2014\u52A0\u4E86\u53CD\u800C\u8BA4\u4E0D\u51FA\u6765\u3002"
  - productId: cocoa
    icon: {fileID: 21300000, guid: aec83df8dbc3f8b42b427fae82bc7509, type: 3}
    tagline: "\u51AC\u591C\u91CC\u6367\u5728\u624B\u5FC3\u7684\u6696\u610F"
    story: "\u4E0D\u542B\u4E00\u6EF4\u5496\u5561\uFF0C\u5374\u662F\u5E97\u91CC\u6700\u53D7\u6B22\u8FCE\u7684\u51AC\u5B63\u996E\u54C1\u3002\u53EF\u53EF\u7684\u9999\u6C14\u80FD\u8BA9\u6574\u6761\u8857\u7684\u4EBA\u56DE\u5934\u3002"
    steps:
    - "\u628A\u53EF\u53EF\u7C89\u4E0E\u6E05\u6C34\u6DF7\u5408\u6210\u53EF\u53EF\u6DB2\u3002"
    - "\u52A0\u5165\u725B\u5976\uFF0C\u4E0E\u53EF\u53EF\u6DB2\u6DF7\u5408\u3002"
    - "\u653E\u4E0A\u7089\u53F0\u52A0\u70ED\uFF0C\u518D\u5012\u5165\u5927\u676F\u51FA\u54C1\u3002"
    tip: "\u70ED\u4E0D\u70ED\u770B\u6E29\u5EA6\uFF0C\u4E0D\u770B\u539F\u6599\u2014\u2014\u522B\u5FD8\u4E86\u52A0\u70ED\u3002"
  - productId: matchalatte
    icon: {fileID: 21300000, guid: 21bfc370f13b0ee40887482da4a31f42, type: 3}
    tagline: "\u8FDC\u65B9\u6765\u7684\u7FE0\u7EFF\u8BBF\u5BA2"
    story: "\u5546\u8239\u4ECE\u8FDC\u65B9\u5E26\u6765\u7684\u62B9\u8336\u7C89\uFF0C\u4E0E\u725B\u5976\u76F8\u9047\u540E\u6E05\u9999\u7EC6\u817B\uFF0C\u662F\u8D35\u5987\u4EBA\u4E0B\u5348\u8336\u7684\u65B0\u5BA0\u3002"
    steps:
    - "\u628A\u62B9\u8336\u7C89\u4E0E\u6E05\u6C34\u6DF7\u5408\u6210\u62B9\u8336\u6DB2\u3002"
    - "\u52A0\u5165\u70ED\u725B\u5976\u6DF7\u5408\u3002"
    - "\u5012\u5165\u5927\u676F\u51FA\u54C1\u3002"
    tip: "\u5C11\u4E86\u725B\u5976\u6216\u6DF7\u5165\u5176\u4ED6\u539F\u6599\uFF0C\u90FD\u4F1A\u53D8\u6210\u300C\u8FF7\u4E4B\u996E\u54C1\u300D\u3002"
  - productId: espresso
    icon: {fileID: 21300000, guid: 2ca24af31db260d45b66c079d4eaa421, type: 3}
    tagline: "\u4E03\u79D2\u534A\u7684\u624B\u827A"
    story: "\u4EE5\u7CBE\u5BC6\u8403\u53D6\u6EE4\u676F\u8BA1\u65F6\u6CE8\u6C34\u3002\u65F6\u95F4\u3001\u6C34\u91CF\u4E0E\u5747\u5300\uFF0C\u5DEE\u4E00\u5206\u90FD\u7792\u4E0D\u8FC7\u884C\u5BB6\u7684\u820C\u5934\u3002"
    steps:
    - "\u7814\u78E8\u5496\u5561\u7C89\uFF0C\u88C5\u5165\u7CBE\u5BC6\u8403\u53D6\u6EE4\u676F\u3002"
    - "\u7528\u70ED\u6C34\u8BA1\u65F6\u6CE8\u5165\uFF1A\u7EA6 7.5 \u79D2\u3001200
      ml\uFF0C\u4FDD\u6301\u5747\u5300\u3002"
    - "\u505C\u6B62\u6CE8\u6C34\u7ED3\u7B97\u540E\uFF0C\u624D\u5F97\u5230\u7CBE\u7CB9\u5496\u5561\u3002"
    - "\u5012\u5165\u5C0F\u676F\u51FA\u54C1\u3002"
    tip: "\u52A0\u70ED\u666E\u901A\u51B7\u8403\u53EA\u4F1A\u5F97\u5230\u9ED1\u5496\u5561\uFF0C\u4EE3\u66FF\u4E0D\u4E86\u7CBE\u7CB9\u3002"
  - productId: macchiato
    icon: {fileID: 21300000, guid: fdb80d57d19d6594a9fa0223d4bb0878, type: 3}
    tagline: "\u7CBE\u7CB9\u4E4B\u4E0A\u7684\u4E00\u70B9\u767D"
    story: "\u5728\u7CBE\u7CB9\u5496\u5561\u4E0A\u70B9\u7F00\u4E00\u5C42\u62C9\u82B1\u3002\u6D53\u70C8\u4E0E\u7EF5\u67D4\u4E4B\u95F4\uFF0C\u53EA\u9694\u7740\u8584\u8584\u4E00\u5C42\u767D\u3002"
    steps:
    - "\u8403\u53D6\u7CBE\u7CB9\u5496\u5561\uFF0C\u5012\u5165\u5C0F\u676F\u3002"
    - "\u5411\u62C9\u82B1\u676F\u52A0\u5165\u725B\u5976\u5E76\u6253\u5976\u3002"
    - "\u628A\u62C9\u82B1\u676F\u62D6\u5230\u676F\u5B50\u4E0A\uFF0C\u5B8C\u6210\u62C9\u82B1\u3002"
    tip: "\u70ED\u725B\u5976\u4EE3\u66FF\u4E0D\u4E86\u62C9\u82B1\uFF1B\u56FE\u6848\u968F\u4F60\u53D1\u6325\u3002"
  - productId: latte
    icon: {fileID: 21300000, guid: 56da0ceaad0ea224aaea7a785bb264c7, type: 3}
    tagline: "\u676F\u9762\u4E0A\u7684\u4E00\u9897\u5FC3"
    story: "\u7CBE\u7CB9\u3001\u70ED\u725B\u5976\u4E0E\u62C9\u82B1\uFF0C\u4E09\u8005\u7F3A\u4E00\u4E0D\u53EF\u3002\u5E97\u91CC\u7684\u62DB\u724C\uFF0C\u4E5F\u662F\u68C0\u9A8C\u5496\u5561\u5E08\u624B\u827A\u7684\u8BD5\u91D1\u77F3\u3002"
    steps:
    - "\u8403\u53D6\u7CBE\u7CB9\u5496\u5561\uFF0C\u5012\u5165\u5927\u676F\u3002"
    - "\u52A0\u5165\u70ED\u725B\u5976\u3002"
    - "\u5411\u62C9\u82B1\u676F\u52A0\u5165\u725B\u5976\u5E76\u6253\u5976\uFF0C\u518D\u62D6\u5230\u676F\u4E0A\u5B8C\u6210\u62C9\u82B1\u3002"
    tip: "\u56FE\u6848\u4E0D\u9650\uFF0C\u4F46\u4E00\u5B9A\u8981\u5B8C\u6210\u62C9\u82B1\u624D\u7B97\u62FF\u94C1\u3002"
  - productId: honeylatte
    icon: {fileID: 21300000, guid: d974e89069a4857419b1d3dc6c668b38, type: 3}
    tagline: "\u4E00\u52FA\u8702\u871C\uFF0C\u4E00\u65E5\u597D\u5FC3\u60C5"
    story: "\u5728\u62FF\u94C1\u91CC\u8C03\u8FDB\u8702\u871C\uFF0C\u751C\u5F97\u6070\u5230\u597D\u5904\u3002\u82B1\u5E02\u7684\u59D1\u5A18\u4EEC\u6BCF\u5468\u90FD\u4F1A\u6765\u70B9\u4E0A\u4E00\u676F\u3002"
    steps:
    - "\u8403\u53D6\u7CBE\u7CB9\u5496\u5561\uFF0C\u52A0\u5165\u70ED\u725B\u5976\u3002"
    - "\u52A0\u5165\u4E00\u4EFD\u8702\u871C\u3002"
    - "\u5411\u62C9\u82B1\u676F\u6253\u5976\uFF0C\u518D\u62D6\u5230\u676F\u4E0A\u5B8C\u6210\u62C9\u82B1\u3002"
    tip: "\u8702\u871C\u5FC5\u4E0D\u53EF\u5C11\uFF0C\u5C11\u4E86\u5B83\u5C31\u53EA\u662F\u666E\u901A\u62FF\u94C1\u3002"
  shopItems:
  - latte: 0
    title: "\u7CBE\u7CB9\u8403\u53D6\u7EC4"
    subtitle: "\u7CBE\u5BC6\u8403\u53D6\u58F6  \xB7  \u4E13\u7528\u6EE4\u676F"
    pitch: "\u4EE5\u8BA1\u65F6\u6CE8\u6C34\u8403\u53D6\u51FA\u6D53\u90C1\u7684\u7CBE\u7CB9\u5496\u5561\u3002\u4ECE\u6B64\u7CBE\u7CB9\u5496\u5561\u53EF\u4EE5\u5165\u5355\uFF0C\u4E5F\u4E3A\u65E5\u540E\u7684\u62FF\u94C1\u6253\u4E0B\u5E95\u5B50\u3002"
    artIds:
    - container.extractor
    - container.extractor.filter
  - latte: 1
    title: "\u62C9\u82B1\u5957\u88C5"
    subtitle: "\u62C9\u82B1\u676F  \xB7  \u6253\u5976\u6405\u62CC\u5668"
    pitch: "\u6253\u51FA\u7EF5\u5BC6\u7684\u5976\uFF0C\u5728\u676F\u9762\u753B\u51FA\u5FC3\u5F62\u4E0E\u53F6\u7247\u3002\u914D\u5408\u7CBE\u7CB9\u8403\u53D6\u7EC4\uFF0C\u62FF\u94C1\u3001\u739B\u5947\u6735\u3001\u8702\u871C\u62FF\u94C1\u7686\u53EF\u4E0A\u5355\u3002"
    artIds:
    - container.milk-pitcher
    - machine.mixer
  practices:
  - extraction: 0
    title: "\u9ED1\u5496\u5561 \xB7 \u57FA\u7840\u7EC3\u4E60"
    icon: {fileID: 21300000, guid: 8a79ee7c550a49c409e45de6e7aedab2, type: 3}
    description: "\u8DDF\u7740\u6307\u5F15\u8D70\u4E00\u904D\uFF1A\u7814\u78E8\u5496\u5561\u8C46\u3001\u7C89\u6C34\u6DF7\u5408\u6210\u51B7\u8403\u3001\u4E0A\u7089\u53F0\u52A0\u70ED\uFF0C\u6700\u540E\u88C5\u676F\u6309\u94C3\u51FA\u54C1\u3002"
  - extraction: 1
    title: "\u7CBE\u7CB9\u5496\u5561 \xB7 \u8403\u53D6\u7EC3\u4E60"
    icon: {fileID: 21300000, guid: 2ca24af31db260d45b66c079d4eaa421, type: 3}
    description: "\u5B66\u4E60\u7CBE\u5BC6\u8403\u53D6\uFF1A\u5496\u5561\u7C89\u88C5\u5165\u6EE4\u676F\uFF0C\u4EE5\u70ED\u6C34\u8BA1\u65F6\u6CE8\u5165\uFF0C\u4F53\u4F1A\u65F6\u95F4\u3001\u6C34\u91CF\u4E0E\u5747\u5300\u3002"
  counterGuide:
  - "\u62D6\u62FD\u539F\u6599\u4E0E\u5BB9\u5668\u5373\u53EF\u64CD\u4F5C\uFF1A\u8C46\u5B50\u62D6\u8FDB\u78E8\u8C46\u673A\uFF0C\u7C89\u548C\u6C34\u5012\u8FDB\u540C\u4E00\u4E2A\u5BB9\u5668\u3002"
  - "\u5496\u5561\u7C89\u4E0E\u6E05\u6C34\u6DF7\u5408\u5373\u662F\u51B7\u8403\uFF1B\u653E\u4E0A\u7089\u53F0\u5E76\u70B9\u51FB\u52A0\u70ED\uFF0C\u5C31\u6210\u4E86\u9ED1\u5496\u5561\u3002"
  - "\u725B\u5976\u5012\u8FDB\u62C9\u82B1\u676F\u6253\u5976\uFF0C\u518D\u62D6\u5230\u996E\u54C1\u676F\u4E0A\u5B8C\u6210\u62C9\u82B1\u3002"
  - "\u996E\u54C1\u5012\u5165\u5BF9\u5E94\u676F\u578B\uFF0C\u653E\u5230\u51FA\u9910\u53E3\uFF0C\u6309\u94C3\u4EA4\u7ED9\u5BA2\u4EBA\u3002"
  - "\u8BC4\u4EF7\u53EA\u770B\u6700\u7EC8\u6210\u5206\u4E0E\u7528\u91CF\uFF0C\u4E0D\u770B\u52A0\u6599\u987A\u5E8F\uFF1B\u591A\u653E\u5C11\u653E\u90FD\u4F1A\u5F71\u54CD\u8BC4\u5206\u3002"
  - "\u505A\u574F\u4E86\u4E5F\u522B\u614C\uFF0C\u5012\u8FDB\u5E9F\u5F03\u6876\u91CD\u6765\u5C31\u597D\u3002"
  catalogIntro: "\u8FD9\u672C\u624B\u8BB0\u8BB0\u5F55\u7740\u5E97\u91CC\u6BCF\u4E00\u676F\u5496\u5561\u7684\u505A\u6CD5\u3002\u5DF2\u638C\u63E1\u7684\u914D\u65B9\u968F\u65F6\u53EF\u4EE5\u7167\u505A\uFF1B\u5C1A\u672A\u89E3\u9501\u7684\uFF0C\u4E5F\u4E0D\u59A8\u5148\u8BA4\u8BA4\u5B83\u4EEC\u7684\u6A21\u6837\u3002"
  shopMasthead: "\u656C\u542F\u8005\uFF1A\u672C\u884C\u627F\u529E\u738B\u90FD\u5404\u5927\u5496\u5561\u9986\u4E4B\u5668\u5177\uFF0C\u8D27\u771F\u4EF7\u5B9E\uFF0C\u4E0B\u5355\u5F53\u65E5\u5373\u9001\u62B5\u5427\u53F0\u3002\u4EE5\u4E0B\u4E24\u4EF6\u4E43\u9547\u5E97\u4E4B\u5B9D\uFF0C\u8BDA\u9080\u9601\u4E0B\u8BA2\u8D2D\u3002"
  shopFinePrint: "\xB7 \u8425\u4E1A\u524D\u6216\u6253\u70CA\u540E\u529E\u7406\u8BA2\u8D2D\uFF0C\u8425\u4E1A\u4E2D\u6055\u4E0D\u63A5\u5355\u3002\n\xB7
    \u987B\u7D2F\u8BA1\u8DB3\u591F\u7684\u6210\u529F\u51FA\u54C1\u65B9\u53EF\u8BA2\u8D2D\uFF0C\u4EE5\u514D\u7CDF\u8E4B\u597D\u8D27\u3002\n\xB7
    \u8D27\u6B3E\u4EE5\u738B\u56FD\u5E01\u5F53\u9762\u7ED3\u6E05\uFF0C\u6982\u4E0D\u8D4A\u8D26\u3002\n\xB7
