    displayCode: "\u4E2D\u7ACB A / End if1"
    notes: "\u591C\u3002\u4E3B\u89D2\u5728\u72ED\u5C0F\u65B0\u4F4F\u5904\u7684\u5C0F\u684C\u8FB9\u5750\u4E0B\uFF0C\u5C31\u7740\u706F\u7AEF\u8D77\u4E00\u676F\u81EA\u716E\u7684\u5496\u5561\uFF1B\u67DC\u4E0A\u6446\u7740\u53D4\u53D4\u7559\u4E0B\u7684\u65E7\u6302\u949F\uFF0C\u949F\u9762\u521A\u88AB\u64E6\u8FC7\u3002\u7A97\u5916\u662F\u5723\u8BFA\u7279\u7684\u591C\uFF0C\u8FDC\u5904\u5362\u7C73\u6069\u6CB3\u4E0A\u8239\u53EA\u9A76\u8FC7\u6865\u4E0B\u3002\u6696\u9EC4\u706F\u5149\u4E0E\u51B7\u84DD\u7A97\u8272\u5BF9\u6BD4\uFF0C\u4EBA\u7269\u53EF\u4F5C\u534A\u8EAB\u6216\u80CC\u5F71\uFF0C\u7A81\u51FA\u5E73\u6DE1\u7684\u4F59\u97F5\u3002"
