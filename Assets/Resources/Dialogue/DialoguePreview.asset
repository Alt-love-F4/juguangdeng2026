  m_Script: {fileID: 11500000, guid: 9192bba8002b3774aa4e5e27a5d5c325, type: 3}
  m_Name: DialoguePreview
  m_EditorClassIdentifier: Spotlight.GameFlow.UI::Spotlight.GameFlow.DialogueScriptAsset
  title: "\u5496\u5561\u9986 \xB7 \u4E0D\u671F\u800C\u81F3\u7684\u8BBF\u5BA2"
  leftCharacter:
    displayName: "\u5496\u5561\u9986\u5E97\u4E3B"
    portrait: {fileID: -5580901551210181490, guid: 702084c7b8ffbab4580ffabc27dd4bae, type: 3}
  rightCharacter:
    displayName: "\u5370\u5237\u5DE5"
    portrait: {fileID: -1957561749201892201, guid: 5b19a7e4f57eed94fab89cfa7303472e, type: 3}
  background: {fileID: 2800000, guid: 9fe0545acc87a6648bdd33cd6fd829a9, type: 3}
  lines:
  - speaker: 0
    text: "\u508D\u665A\u7684\u6700\u540E\u4E00\u7F15\u5149\u7A7F\u8FC7\u73BB\u7483\u3002\u95E8\u94C3\u54CD\u8D77\uFF0C\u4E00\u4F4D\u5E26\u7740\u6CB9\u58A8\u6C14\u5473\u7684\u5BA2\u4EBA\u8D70\u8FDB\u5496\u5561\u9986\u3002"
    speakerNameOverride: 
    gesture: 0
    autoAdvanceSeconds: 0
    replaceLeft: 0
    leftCharacter:
      displayName: 
      portrait: {fileID: 0}
    replaceRight: 0
    rightCharacter:
      displayName: 
      portrait: {fileID: 0}
  - speaker: 1
    text: "\u6B22\u8FCE\u5149\u4E34\u3002\u4ECA\u5929\u60F3\u559D\u70B9\u4EC0\u4E48\uFF1F"
    speakerNameOverride: 
    gesture: 0
    autoAdvanceSeconds: 0
    replaceLeft: 0
    leftCharacter:
      displayName: 
      portrait: {fileID: 0}
    replaceRight: 0
    rightCharacter:
      displayName: 
      portrait: {fileID: 0}
  - speaker: 2
    text: "\u4E00\u676F\u70ED\u5496\u5561\uFF0C\u4E0D\u52A0\u7CD6\u3002\u8FD8\u6709\u2026\u2026\u6211\u60F3\u5728\u8FD9\u91CC\u7B49\u4E00\u4E2A\u4EBA\u3002"
    speakerNameOverride: 
    gesture: 0
    autoAdvanceSeconds: 0
    replaceLeft: 0
    leftCharacter:
      displayName: 
      portrait: {fileID: 0}
    replaceRight: 0
    rightCharacter:
      displayName: 
      portrait: {fileID: 0}
  - speaker: 1
    text: "\u5F53\u7136\u3002\u9760\u7A97\u7684\u4F4D\u7F6E\u8FD8\u7A7A\u7740\uFF0C\u4F60\u53EF\u4EE5\u6162\u6162\u7B49\u3002"
    speakerNameOverride: 
    gesture: 1
    autoAdvanceSeconds: 0
    replaceLeft: 0
    leftCharacter:
      displayName: 
      portrait: {fileID: 0}
    replaceRight: 0
    rightCharacter:
      displayName: 
      portrait: {fileID: 0}
  - speaker: 2
    text: "\u8C22\u8C22\u3002\u6709\u4E9B\u8BDD\uFF0C\u53EA\u6709\u5728\u8FD9\u6837\u5B89\u9759\u7684\u5730\u65B9\u624D\u8BF4\u5F97\u51FA\u53E3\u3002"
    speakerNameOverride: 
    gesture: 0
    autoAdvanceSeconds: 0
    replaceLeft: 0
    leftCharacter:
      displayName: 
      portrait: {fileID: 0}
    replaceRight: 0
    rightCharacter:
      displayName: 
      portrait: {fileID: 0}
  - speaker: 0
    text: "\u57CE\u91CC\u7684\u5370\u5237\u673A\u5DF2\u7ECF\u505C\u4E86\u4E09\u5929\uFF0C\u8857\u4E0A\u5374\u6BD4\u5F80\u5E38\u66F4\u52A0\u70ED\u95F9\u3002\u6709\u4EBA\u5728\u5BFB\u627E\u4E00\u5C01\u6CA1\u6709\u7F72\u540D\u7684\u4FE1\uFF0C\u4E5F\u6709\u4EBA\u53EA\u60F3\u627E\u4E2A\u5730\u65B9\u5750\u4E0B\u6765\u3002\n\n\u6211\u539F\u672C\u4EE5\u4E3A\u4ECA\u5929\u53EA\u662F\u666E\u901A\u7684\u4E00\u5929\uFF0C\u76F4\u5230\u4ED6\u628A\u90A3\u5F20\u6298\u4E86\u56DB\u6B21\u7684\u7EB8\u653E\u5728\u684C\u4E0A\u3002\u7EB8\u8FB9\u6CBE\u7740\u6CB9\u58A8\uFF0C\u5B57\u8FF9\u5374\u975E\u5E38\u6E05\u695A\u3002\u90A3\u4E0D\u662F\u4E00\u5F20\u8BA2\u5355\uFF0C\u800C\u662F\u4E00\u4EFD\u540D\u5355\u3002\n\n\u6211\u6CA1\u6709\u95EE\u540D\u5355\u4E0A\u662F\u8C01\u3002\u4ED6\u4E5F\u6CA1\u6709\u89E3\u91CA\u3002\u95E8\u5916\u53C8\u4F20\u6765\u4E00\u9635\u811A\u6B65\u58F0\uFF0C\u6211\u4EEC\u540C\u65F6\u770B\u5411\u7A97\u8FB9\u3002\n\n\u6709\u4E9B\u6545\u4E8B\uFF0C\u4ECE\u4E00\u676F\u5496\u5561\u5F00\u59CB\uFF0C\u5374\u4E0D\u4F1A\u5728\u5496\u5561\u51C9\u4E0B\u6765\u65F6\u7ED3\u675F\u3002"
    speakerNameOverride: 
    gesture: 0
    autoAdvanceSeconds: 0
    replaceLeft: 0
    leftCharacter:
      displayName: 
      portrait: {fileID: 0}
    replaceRight: 0
    rightCharacter:
      displayName: 
      portrait: {fileID: 0}
  - speaker: 1
    text: "\u90A3\u5C31\u5148\u559D\u4E00\u53E3\u5427\u3002\u65E0\u8BBA\u5916\u9762\u53D1\u751F\u4EC0\u4E48\uFF0C\u8FD9\u676F\u5496\u5561\u90FD\u8FD8\u662F\u70ED\u7684\u3002"
    speakerNameOverride: 
    gesture: 0
    autoAdvanceSeconds: 0
    replaceLeft: 0
    leftCharacter:
      displayName: 
      portrait: {fileID: 0}
    replaceRight: 0
    rightCharacter:
      displayName: 
      portrait: {fileID: 0}
